<Page x:Class="ImmurokClient.Views.FeaturesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      Title="{loc:Tr nav.features}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr nav.features}" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Tr features.subtitle}" Opacity="0.6" Margin="0,0,0,20" />

            <!-- 屏幕解锁 -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="ShieldKeyhole24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr features.unlock}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr features.unlock.hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock x:Name="UnlockWarn" Text="{loc:Tr features.unlock.nopassword}"
                                   Foreground="#FFE0A030" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="UnlockToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnToggle" Tag="unlock" />
                </Grid>
            </ui:Card>

            <!-- 屏幕锁定 -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Desktop24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr features.lock}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr features.lock.hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="LockToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnToggle" Tag="lock" />
                </Grid>
            </ui:Card>

            <!-- SSH agent -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Key24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr features.ssh}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr features.ssh.hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="SshToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnToggle" Tag="ssh" />
                </Grid>
            </ui:Card>

            <!-- imk agent -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Link24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr features.agent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr features.agent.hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="AgentToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnToggle" Tag="agent" />
                </Grid>
            </ui:Card>

            <!-- OTP -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="ArrowClockwise24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Tr features.otp}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Tr features.otp.hint}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch x:Name="OtpToggle" Grid.Column="1" VerticalAlignment="Center" Click="OnToggle" Tag="otp" />
                </Grid>
            </ui:Card>

            <TextBlock x:Name="StatusText" Text="" Opacity="0.75" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
