<Page x:Class="ImmurokClient.Views.PasswordInjectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      Title="{loc:Tr nav.inject}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <StackPanel Margin="28,24,28,24" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr inject.title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Tr inject.subtitle}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16" />

            <ui:Button Content="{loc:Tr inject.add}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                       Click="OnAddClick" Margin="0,0,0,16" />

            <ItemsControl x:Name="ListPanel" />
            <TextBlock x:Name="EmptyText" Text="{loc:Tr inject.empty}" Opacity="0.5" FontSize="12"
                       Visibility="Collapsed" Margin="2,0,0,0" />

            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
