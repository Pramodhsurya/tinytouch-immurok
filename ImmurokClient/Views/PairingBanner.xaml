<UserControl x:Class="ImmurokClient.Views.PairingBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:ImmurokClient.Localization"
             Visibility="Collapsed">
    <!-- 外边距放在内层 Border 上：控件整体 Collapsed 时不能再占一段空白。 -->
    <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,14"
            Background="#22E0A030" BorderBrush="#55E0A030" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Warning24" Foreground="#FFE0A030" FontSize="18"
                               Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr msg.pair.required_banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="{loc:Tr msg.pair.goto}" Icon="{ui:SymbolIcon Link24}"
                       Appearance="Primary" Click="OnGoClick" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
