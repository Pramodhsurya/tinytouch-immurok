<Page x:Class="ImmurokClient.Views.DevicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      Title="{loc:Tr nav.device}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr nav.device}" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Tr device.subtitle}" Opacity="0.6" Margin="0,0,0,20" />

            <!-- 连接状态 -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Bluetooth24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr device.conn}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ConnText" Text="{loc:Tr common.querying}" Opacity="0.85" />
                    <TextBlock x:Name="InfoText" Text="" Margin="0,6,0,0" Opacity="0.6" FontSize="12" />
                </StackPanel>
            </ui:Card>

            <!-- 配对 -->
            <ui:Card Margin="0,0,0,14" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Link24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr device.pair}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PairText" Text="{loc:Tr common.querying}" Opacity="0.85" Margin="0,0,0,10" />
                    <ui:Button x:Name="PairBtn" Content="{loc:Tr device.pair.start}" Icon="{ui:SymbolIcon Link24}" Click="OnPairClick" />
                    <TextBlock x:Name="PairHint"
                               Text="{loc:Tr device.pair.hint}"
                               Margin="0,8,0,0" Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- 双主机 -->
            <ui:Card x:Name="DualHostCard" Margin="0,0,0,14" Padding="18" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Desktop24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr device.dual}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Tr device.dual.desc}"
                               Opacity="0.6" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <Border x:Name="Slot1Row" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                            Background="#14808080">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr device.slot1}" Width="60" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="Slot1State" Text="" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Slot2Row" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                            Background="#14808080">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr device.slot2}" Width="60" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="Slot2State" Text="" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="UnbindSelfBtn" Content="{loc:Tr device.unbind.self}" Icon="{ui:SymbolIcon PlugDisconnected24}"
                                   Appearance="Secondary" Click="OnUnbindSelfClick" Margin="0,0,8,0" />
                        <ui:Button x:Name="UnbindOtherBtn" Content="{loc:Tr device.unbind.other}" Icon="{ui:SymbolIcon Delete24}"
                                   Appearance="Secondary" Click="OnUnbindOtherClick" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="DualHint" Text="" Margin="0,8,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Button Content="{loc:Tr common.refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Secondary" Click="OnRefreshClick" />
        </StackPanel>
    </ScrollViewer>
</Page>
