<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <!--
      ARM64：Credential Provider 是被 LogonUI 在进程内加载的 DLL，而 Windows 不允许
      跨架构在同一进程内加载 —— ARM64 机器上的 LogonUI 是原生 ARM64 进程，必须有
      原生 ARM64 的 CP，x64 版靠模拟也顶不上。
      需要在 Visual Studio Installer 里安装 C++ 的 ARM64/ARM64EC 生成工具组件。
    -->
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C467D11D-4635-495D-8AF9-41F31366E6E6}</ProjectGuid>
    <RootNamespace>ImmurokCredentialProvider</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!--
    平台工具集跟随当前所用的 Visual Studio（$(DefaultPlatformToolset) 由上面的
    Microsoft.Cpp.Default.props 设置），不写死 v143：写死会导致换一个 VS 大版本就报
    MSB8020「找不到平台工具集 v143」。取不到时回落到 v143。
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)' != ''">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset Condition="'$(DefaultPlatformToolset)' != ''">$(DefaultPlatformToolset)</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>ImmurokCredentialProvider.def</ModuleDefinitionFile>
      <!-- Credential Provider 常用依赖库 -->
      <AdditionalDependencies>credui.lib;Secur32.lib;Shlwapi.lib;Advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!--
        静态链接 CRT（/MT）。默认的 /MD 会让这个 DLL 依赖 VC++ 运行库
        （vcruntime140.dll 等），而安装包并不分发它 —— 目标机上缺运行库时，
        LogonUI 会加载失败，表现为锁屏解锁静默失效、且没有任何提示。
        CP 是被系统进程在进程内加载的，宁可换取体积也要消除这类外部依赖。
      -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="CSampleProvider.cpp" />
    <ClCompile Include="CSampleCredential.cpp" />
    <ClCompile Include="CPipeListener.cpp" />
    <ClCompile Include="Dll.cpp" />
    <ClCompile Include="helpers.cpp" />
    <ClCompile Include="guid.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="CSampleProvider.h" />
    <ClInclude Include="CSampleCredential.h" />
    <ClInclude Include="CPipeListener.h" />
    <ClInclude Include="Dll.h" />
    <ClInclude Include="helpers.h" />
    <ClInclude Include="common.h" />
    <ClInclude Include="guid.h" />
    <ClInclude Include="resource.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="resources.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ImmurokCredentialProvider.def" />
    <None Include="Register.reg" />
    <None Include="Unregister.reg" />
  </ItemGroup>
  <ItemGroup>
    <Image Include="tileimage.bmp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
