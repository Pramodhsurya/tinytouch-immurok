<ui:FluentWindow x:Class="ImmurokClient.Views.FpAuthDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:ImmurokClient.Localization"
                 Width="420"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Grid.Row="0" Title="{loc:Tr fpauth.title}" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,6,24,22">

            <!-- 指纹图示 -->
            <Grid Width="140" Height="140" HorizontalAlignment="Center">
                <Ellipse x:Name="Plate" Width="128" Height="128"
                         Fill="#14808080" Stroke="#33808080" StrokeThickness="1.5" />
                <Ellipse x:Name="Pulse" Width="128" Height="128" Fill="#330078D4" />
                <ui:SymbolIcon x:Name="FpGlyph" Symbol="Fingerprint24" FontSize="76"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 主标题 + 具体操作 -->
            <TextBlock x:Name="HeadText" Text="{loc:Tr fpauth.head}" HorizontalAlignment="Center"
                       FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0" />
            <TextBlock x:Name="ActionText" Text="" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="34" />

            <!-- 30s 倒计时 -->
            <ProgressBar x:Name="Countdown" Height="6" Minimum="0" Maximum="100" Value="100" Margin="0,6,0,0" />
            <TextBlock x:Name="SecondsText" Text="" HorizontalAlignment="Center"
                       FontSize="12" Opacity="0.6" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="CloseBtn" Content="{loc:Tr common.cancel}"
                           Appearance="Secondary" MinWidth="96" Click="OnCloseClick" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
