<Page x:Class="ImmurokClient.Views.StatusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      Title="{loc:Tr nav.status}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <StackPanel Margin="28,24,28,24" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr status.header}" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Tr status.subtitle}" Opacity="0.6" Margin="0,0,0,20" />
            <ui:Card Padding="18">
                <StackPanel x:Name="ChecklistPanel">
                    <TextBlock Text="{loc:Tr common.checking}" Opacity="0.8" />
                </StackPanel>
            </ui:Card>
            <ui:Button Content="{loc:Tr common.recheck}" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Secondary" Margin="0,14,0,0" Click="OnRefreshClick" />
        </StackPanel>
    </ScrollViewer>
</Page>
