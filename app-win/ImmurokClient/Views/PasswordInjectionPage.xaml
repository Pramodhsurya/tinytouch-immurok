<Page x:Class="ImmurokClient.Views.PasswordInjectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:ImmurokClient.Localization"
      xmlns:h="clr-namespace:ImmurokClient.Helpers"
      xmlns:v="clr-namespace:ImmurokClient.Views"
      Title="{loc:Tr nav.inject}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" h:WheelScroll.Enabled="True">
        <StackPanel Margin="28,24,28,24" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr inject.title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Tr inject.subtitle}" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- 注入项本身是本地配置，未配对也能先配好；但触发注入要靠指纹，所以提示照给。 -->
            <v:PairingBanner x:Name="PairBanner" />

            <!-- 内置支持：随客户端发布的已知目标，点一下只需再填自己的密码。
                 只锁应用身份，不带界面模板（模板会随应用版本失效）。 -->
            <ui:Card x:Name="PresetCard" Margin="0,0,0,14" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="AppsAddIn24" FontSize="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr inject.presets}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Tr inject.presets.desc}" Opacity="0.6" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ItemsControl x:Name="PresetPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Button Content="{loc:Tr inject.add}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary"
                       Click="OnAddClick" Margin="0,0,0,16" />

            <ItemsControl x:Name="ListPanel" />
            <TextBlock x:Name="EmptyText" Text="{loc:Tr inject.empty}" Opacity="0.5" FontSize="12"
                       Visibility="Collapsed" Margin="2,0,0,0" />

            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
